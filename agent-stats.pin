# The agent-stats release Tokiscope ships as Contents/Helpers/agent-stats: its version, and the SHA256 of each Mac
# archive (from the release's SHA256SUMS). build.sh downloads both, checks them against these and merges them into
# one universal binary. A pull request bumps this when agent-stats releases.
version=0.5.0
aarch64-apple-darwin=
x86_64-apple-darwin=
